{
  "envFiles": ["packages/runtime/.env", "packages/client/.env"],
  "portGroups": [
    {
      "name": "server",
      "basePort": 3001,
      "envVars": ["PORT", "VITE_SERVER_PORT"]
    },
    {
      "name": "client",
      "basePort": 5173,
      "envVars": ["VITE_PORT", "CLIENT_PORT"]
    }
  ],
  "postCreate": [
    "bun install",
    "cp -n /opt/funny/packages/native-git/*.node packages/native-git/ 2>/dev/null || true"
  ]
}
