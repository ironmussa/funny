{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // The client is a leaf app — nothing consumes its .d.ts. Skipping declaration
    // emit keeps the tsc gate fast and avoids TS2742 from non-portable inferred
    // types (e.g. better-auth's zod-backed client) that only surface during emit.
    "declaration": false,
    "declarationMap": false,
    "outDir": "./dist",
    // Includes source-linked workspace packages when Bun's workspace symlink is
    // unavailable (for example, an offline checkout using the explicit paths below).
    // Vite owns the final dist output and clears TypeScript's transient emit.
    "rootDir": "..",
    // No baseUrl — deprecated in TS6 / removed in TS7. `paths` resolve
    // relative to this tsconfig's directory, so "@/*" still maps to ./src/*.
    "paths": {
      "@/*": ["./src/*"],
      "@funny/client-core": ["../client-core/src/index.ts"],
      "@funny/client-core/*": ["../client-core/src/*"]
    }
  },
  "include": ["src"]
}
