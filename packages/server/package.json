{
  "name": "@funny/server",
  "version": "0.1.0",
  "private": false,
  "description": "Funny server for team coordination — manages users, projects, memberships, and runner dispatch.",
  "license": "MIT",
  "bin": {
    "funny-server": "./bin/funny-server.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "db:migrate": "bun src/hosts/bun/migrate-cli.ts",
    "build": "bun run build.ts",
    "start": "bun run dist/index.js",
    "test": "bun test --isolate --timeout 20000",
    "test:coverage": "bun test --coverage --isolate --timeout 20000",
    "test:coverage:gate": "bun scripts/coverage-gate.ts"
  },
  "dependencies": {
    "@abbacchio/transport": "^0.2.0",
    "@bufbuild/protobuf": "2.14.0",
    "@funny/api": "workspace:*",
    "@funny/core": "workspace:*",
    "@funny/shared": "workspace:*",
    "@funny/thread-scheduler": "workspace:*",
    "@gdp-ts/core": "0.1.0",
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.0",
    "@ironmussa/funny-runtime": "workspace:*",
    "@socket.io/bun-engine": "^0.1.0",
    "@trpc/server": "11.28.0",
    "better-auth": "^1.7.7",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.4",
    "hono": "^4.13.13",
    "kysely": "^0.29.2",
    "nanoid": "^5.0.9",
    "neverthrow": "^8.2.0",
    "nodemailer": "^10.1.4",
    "pg": "^8.20.0",
    "socket.io": "4.8.4",
    "trpc-to-openapi": "3.5.0",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.6",
    "zod-openapi": "^5.4.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.18.0",
    "@types/web-push": "^3.6.4",
    "socket.io-client": "4.8.4"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
