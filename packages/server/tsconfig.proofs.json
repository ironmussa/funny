// name from another call, so the cross-scope @ts-expect-error cases below
// would pass: 7 "unused @ts-expect-error" errors. Do not move this to bun check
// until it reports none of them.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"],
    "noEmit": true
  },
  "include": ["type-tests/fork-ownership.ts", "type-tests/runner-isolation.ts"]
}
